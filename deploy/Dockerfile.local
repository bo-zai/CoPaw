# -----------------------------------------------------------------------------
# Local development: skip console build (dist already exists in repo)
# -----------------------------------------------------------------------------
FROM agentscope-registry.ap-southeast-1.cr.aliyuncs.com/agentscope/node:slim

# ENV variables
ENV NODE_ENV=production
ENV WORKSPACE_DIR=/app
ENV SWE_WORKING_DIR=/app/working
ENV SWE_SECRET_DIR=/app/working.secret

ARG SWE_DISABLED_CHANNELS="imessage"
ENV SWE_DISABLED_CHANNELS=${SWE_DISABLED_CHANNELS}
ARG SWE_ENABLED_CHANNELS=""
ENV SWE_ENABLED_CHANNELS=${SWE_ENABLED_CHANNELS}

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --fix-missing \
    curl \
    python3 \
    python3-pip \
    python3.11-venv \
    build-essential \
    libssl-dev \
    zlib1g-dev \
    libreadline-dev \
    libsqlite3-dev \
    libncurses5-dev \
    libncursesw5-dev \
    libffi-dev \
    liblzma-dev \
    tk-dev \
    git \
    supervisor \
    vim \
    gettext-base \
    xfce4 \
    xfce4-terminal \
    xvfb \
    dbus-x11 \
    fonts-wqy-zenhei \
    fonts-wqy-microhei \
    wget \
  && rm -rf /var/lib/apt/lists/* \
  && apt-get clean

# Install Python 3.12 via pyenv
RUN curl -fsSL https://pyenv.run | bash && \
    /root/.pyenv/bin/pyenv install 3.12.6 && \
    /root/.pyenv/bin/pyenv global 3.12.6 && \
    /root/.pyenv/versions/3.12.6/bin/python -m venv /app/venv

ENV PATH="/app/venv/bin:$PATH"
RUN pip install --upgrade pip

RUN apt-get update && apt-get install -y --fix-missing \
    chromium \
    chromium-sandbox \
    libx11-xcb1 \
    libxcomposite1 \
    libxdamage1 \
    libxext6 \
    libxfixes3 \
    libxi6 \
    libxtst6 \
    libnss3 \
    libglib2.0-0 \
    libdrm2 \
    libgbm1 \
    libasound2 \
    fonts-liberation \
    libu2f-udev \
  && rm -rf /var/lib/apt/lists/* \
  && apt-get clean

RUN sed -i 's/^CHROMIUM_FLAGS=""/CHROMIUM_FLAGS="--no-sandbox"/' /usr/bin/chromium

ENV PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
ENV SWE_RUNNING_IN_CONTAINER=1

WORKDIR ${WORKSPACE_DIR}

COPY pyproject.toml setup.py README.md ./
COPY src ./src
COPY scripts/verify_session_nas_lock.py ./scripts/verify_session_nas_lock.py
COPY console/dist src/swe/console/
RUN pip install --no-cache-dir ".[ollama]" aiomysql pymysql

RUN swe init --defaults --accept-security

ENV SWE_PORT=8088

COPY deploy/config/supervisord.conf.local /etc/supervisor/conf.d/supervisord.conf
COPY --chmod=755 deploy/entrypoint.local.sh /entrypoint.sh

EXPOSE 8088

CMD ["/entrypoint.sh"]
